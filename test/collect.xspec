<?xml version="1.0" encoding="utf-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:doc="https://share.obvsg.at/xml/xsl/doc" xmlns:utils="https://share.obvsg.at/xml/xsl/utils"
               xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
               stylesheet="../xslt/documentation-generator.xsl">

  <x:scenario label="docFromString">
    <x:scenario label="free text only">

      <x:call function="utils:docFromString">
        <x:param name="inString">

    Beginning of text. Indented four spaces
      - two more spaces
        - four more spaces
      - two more spaces

    Text at the base level.
    Another line at base level.

Negative relative indent (0 spaces from left)
        </x:param>
      </x:call>
      <x:expect label="doc:doc with doc:desc">
        <doc:doc scope="element">
          <doc:desc>Beginning of text. Indented four spaces
  - two more spaces
    - four more spaces
  - two more spaces

Text at the base level.
Another line at base level.

Negative relative indent (0 spaces from left)</doc:desc>
        </doc:doc>
      </x:expect>
    </x:scenario>
    <x:scenario label="description and fields">

      <x:call function="utils:docFromString">
        <x:param name="inString">

    Description
    @context marc:datafield
    @param documentedParam A param that is very well documented
    @param undocumentedParam
    @return documentation of the return value
    @references temp;datafield[@tag='245'];nil Template that matches the title field
    @referencedBy temp;dummyTemplate;nil;dummyMode
        </x:param>
      </x:call>
      <x:expect label="doc:doc with doc:desc">
        <doc:doc scope="element">
          <doc:desc>Description</doc:desc>
          <doc:context>marc:datafield</doc:context>
          <doc:param name="documentedParam">A param that is very well documented</doc:param>
          <doc:param name="undocumentedParam" />
          <doc:return>documentation of the return value</doc:return>
          <doc:references ref="temp;datafield[@tag='245'];nil">Template that matches the title field</doc:references>
          <doc:referencedBy ref="temp;dummyTemplate;nil;dummyMode" />
        </doc:doc>
      </x:expect>
    </x:scenario>
    <x:scenario label="global doc">

      <x:call function="utils:docFromString">
        <x:param name="inString">~doc:global
  Global description

  @includeMd README.md
        </x:param>
      </x:call>
      <x:expect label="doc:doc[@scope='global'] with doc:desc and doc:includeMd">
        <doc:doc scope="global">
          <doc:desc>Global description</doc:desc>
          <doc:includeMd href="README.md" />
        </doc:doc>
      </x:expect>
    </x:scenario>
    <x:scenario label="global doc">
      <x:call function="utils:docFromString">
        <x:param name="inString">~doc:stylesheet
  Stylesheet description

  @title stylesheet.xsl
        </x:param>
      </x:call>
      <x:expect label="doc:doc[@scope='global'] with doc:desc and doc:title">
        <doc:doc scope="stylesheet">
          <doc:desc>Stylesheet description</doc:desc>
          <doc:title>stylesheet.xsl</doc:title>
        </doc:doc>
      </x:expect>
    </x:scenario>
  </x:scenario>

</x:description>
