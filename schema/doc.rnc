namespace doc = "http://www.obvsg.at/ns/doc"

start = Doc
Doc = element doc:Doc { doc* }
doc = element doc:doc {
    attribute id { text }?,
    attribute scope { "global" | "stylesheet" | "element" }?,
    element doc:includedFrom { attribute href { text } }?,
    element doc:title { text }?, # only applicable if @scope=("global" or @scope="stylesheet"
    element doc:name { text }?,
    element doc:match { text }?,
    element doc:mode {
        text }?,
    element doc:type { "template" | "function" }?,
    element doc:includeMd { attribute href {text} }?,
    element doc:desc { text }?,
    element doc:context { text }?,
    element doc:param {
        attribute name { text },
        attribute as { text }?,
        attribute required { "yes" | "no" }?,
        text }*,
    element doc:return {
        attribute as { text }?,
        text}?,
    element doc:references {
        reference
    }*,
    element doc:referencedBy {
        reference
    }*
}

reference =
    (attribute ref { text },
     text?
    )
